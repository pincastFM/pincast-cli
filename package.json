{
  "name": "@pincast/cli",
  "version": "0.1.0",
  "description": "The pincast command: make a test app, send sets and collects, and test your webhook receiver.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pincastFM/pincast-cli.git"
  },
  "homepage": "https://github.com/pincastFM/pincast-cli#readme",
  "bugs": {
    "url": "https://github.com/pincastFM/pincast-cli/issues"
  },
  "type": "module",
  "bin": {
    "pincast": "bin/pincast.js"
  },
  "exports": {
    ".": "./src/cli.js",
    "./init": "./src/init/index.js",
    "./webhooks": "./src/webhooks.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "template",
    "template.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@pincast/api": "0.1.0"
  },
  "scripts": {
    "link-api": "node scripts/link-api.mjs",
    "test": "node --test test/*.test.js",
    "changelog": "node scripts/changelog.mjs"
  },
  "keywords": [
    "pincast",
    "placecard",
    "cli",
    "webhooks"
  ]
}
